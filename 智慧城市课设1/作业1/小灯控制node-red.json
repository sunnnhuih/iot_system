  {
    "id": "function_rgb_text",
    "type": "function",
    "z": "tab_rgb_homework",
    "name": "提取RGB状态",
    "func": "let states = flow.get('rgb_states') || { r: 0, g: 0, b: 0 };\nlet payload = msg.payload;\n\nif (typeof payload === 'string') {\n    try {\n        payload = JSON.parse(payload);\n    } catch (e) {\n        payload = {};\n    }\n}\n\nif (payload.color && payload.state !== undefined) {\n    states[payload.color] = Number(payload.state);\n}\n\nif (payload.r !== undefined) states.r = Number(payload.r);\nif (payload.g !== undefined) states.g = Number(payload.g);\nif (payload.b !== undefined) states.b = Number(payload.b);\n\nflow.set('rgb_states', states);\n\nconst stateText = value => value ? '开' : '关';\nreturn [\n    { payload: stateText(states.r) },\n    { payload: stateText(states.g) },\n    { payload: stateText(states.b) }\n];",
    "outputs": 3,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 600,
    "y": 340,
    "wires": [["ui_text_red_status"], ["ui_text_green_status"], ["ui_text_blue_status"]]
  },
